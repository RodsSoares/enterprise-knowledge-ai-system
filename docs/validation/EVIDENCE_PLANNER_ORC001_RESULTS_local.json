              "document_id": "DOC-025",
              "status": "ready",
              "role": "section",
              "reading_text": "3. AI supplier due diligence\n\nCommercial review should consider service commitments, data-processing terms, retention options, intellectual-property provisions, model or service changes, audit rights where applicable, and exit requirements.",
              "section_path": [
                "3. AI supplier due diligence"
              ],
              "metadata": {
                "document_id": "DOC-025",
                "key": "ai_procurement_guidelines",
                "title": "AI Procurement Guidelines",
                "document_type": "guideline",
                "format": "md",
