            {
              "unit_id": "DOC-010::unit-a53055b0da14d0c1a709b3d0c6122c7b5e1f3dd9cd2db9b298381c1721583032",
              "document_id": "DOC-010",
              "status": "ready",
              "role": "section",
              "reading_text": "4. Supplier disclosure\n\nIf confidential data was accidentally sent to a supplier or carrier, the employee must report the incident immediately. Information Security coordinates containment and determines whether Procurement, Legal, Privacy, the business owner, or the supplier must take additional action.",
              "section_path": [
                "4. Supplier disclosure"
              ],
              "metadata": {
