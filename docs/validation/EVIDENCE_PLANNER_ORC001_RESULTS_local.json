            },
            {
              "unit_id": "DOC-006::unit-d706b9b510953eebe8dda536cfd3e270268c2b3515793401748f6b5b34606331",
              "document_id": "DOC-006",
              "status": "ready",
              "role": "section",
              "reading_text": "5. AI processing environments\n\nConfidential information must not be entered into an AI tool unless that tool and use case are approved for the relevant information classification. Required controls include approved access, data handling terms, identity and access management, logging where applicable, and compliance with AI governance requirements.",
              "section_path": [
                "5. AI processing environments"
              ],
              "metadata": {
