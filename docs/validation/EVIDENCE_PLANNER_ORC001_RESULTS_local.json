            {
              "unit_id": "DOC-005::unit-9b0d28fc0e3086af15def6c5a4d43fa93965cbbaa1b1a4ddf2803d4fb420ec35",
              "document_id": "DOC-005",
              "status": "ready",
              "role": "section",
              "reading_text": "3. Information classification and minimum controls\n\nClassification | External sharing rule | Minimum channel/control\nPublic | May be shared when approved for public use. | Approved business channel.\nInternal | Share only for legitimate business need. | Corporate-managed channel.\nConfidential | Share only with an authorized recipient and approved business purpose. | Approved secure transfer or controlled platform; access limited to intended recipients.\nRestricted | External sharing requires explicit authorization under the applicable security or legal control. | Approved restricted-data mechanism and documented authorization.",
              "section_path": [
                "3. Information classification and minimum controls"
              ],
              "metadata": {
