            {
              "unit_id": "DOC-006::unit-4240bdf710f96bf285c6cb88fedf3e0474cf8bba37b45d6fe36dc46f45da1b70",
              "document_id": "DOC-006",
              "status": "ready",
              "role": "section",
              "reading_text": "2. Confidential information\n\nConfidential information includes identifiable customer information, non-public supplier commercial information, credentials and authentication material, non-public contractual terms, sensitive operational data, and other information explicitly classified as confidential by the enterprise.",
              "section_path": [
                "2. Confidential information"
              ],
              "metadata": {
                "document_id": "DOC-006",
