              "document_id": "DOC-005",
              "status": "ready",
              "role": "section",
              "reading_text": "7. Exceptions\n\nExceptions require documented business justification and the approvals defined by the applicable security and authority controls. An operational SOP cannot independently create an exception to a corporate policy.",
              "section_path": [
                "7. Exceptions"
              ],
