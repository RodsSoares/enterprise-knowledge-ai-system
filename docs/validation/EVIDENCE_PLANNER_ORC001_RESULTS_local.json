            {
              "unit_id": "DOC-023::unit-c0dfb9cf96e0468c43fa835e2d176dae41c7d90ab2478e847cee1eb793fb8852",
              "document_id": "DOC-023",
              "status": "ready",
              "role": "section",
              "reading_text": "3. AI analysis of supplier contracts\n\nAI may be used to summarize or analyze supplier contracts only when the tool and use case are approved, applicable confidentiality requirements are satisfied, and the output is treated as analytical support rather than authoritative legal interpretation.",
              "section_path": [
                "3. AI analysis of supplier contracts"
              ],
              "metadata": {
                "document_id": "DOC-023",
                "key": "ai_governance_policy",
                "title": "AI Governance Policy",
                "document_type": "corporate_policy",
                "format": "pdf",
