            {
              "unit_id": "DOC-023::unit-fcca844ee2aa8518e21a50beeb151da9b9a4228d26c4ae86c947598538ef8696",
              "document_id": "DOC-023",
              "status": "ready",
              "role": "section",
              "reading_text": "5. New AI tools\n\nA new AI tool that processes enterprise or supplier data requires approval by the AI Governance Owner, with Information Security and Procurement review. Additional review may be required for legal, privacy, regulated, or high-impact use cases.",
              "section_path": [
                "5. New AI tools"
              ],
