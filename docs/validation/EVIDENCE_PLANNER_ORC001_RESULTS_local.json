              "document_id": "DOC-005",
              "status": "ready",
              "role": "section",
              "reading_text": "2. Scope\n\nApplies to employees, contractors, systems, and business processes that disclose internal, confidential, customer, supplier, or operational information outside the enterprise.",
              "section_path": [
                "2. Scope"
              ],
              "metadata": {
