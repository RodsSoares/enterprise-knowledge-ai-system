              "status": "ready",
              "role": "section",
              "reading_text": "1. Purpose\n\nDefine requirements for sharing enterprise information with external parties, including suppliers, logistics providers, professional services firms, and technology providers.",
              "section_path": [
                "1. Purpose"
              ],
              "metadata": {
                "document_id": "DOC-005",
                "key": "data_sharing_policy",
                "title": "Data Sharing Policy",
                "document_type": "corporate_policy",
