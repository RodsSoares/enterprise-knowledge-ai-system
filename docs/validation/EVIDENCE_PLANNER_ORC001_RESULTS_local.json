            {
              "unit_id": "DOC-025::unit-f306f71b34f133eb9fe59a87b69869457cd73879a69d61a9ca967765e66533ee",
              "document_id": "DOC-025",
              "status": "ready",
              "role": "section",
              "reading_text": "5. Supplier data\n\nThe fact that an AI product is procured does not mean confidential supplier or customer data may automatically be entered into it. Data classification and approved-use requirements remain applicable.",
              "section_path": [
                "5. Supplier data"
              ],
              "metadata": {
                "document_id": "DOC-025",
                "key": "ai_procurement_guidelines",
                "title": "AI Procurement Guidelines",
                "document_type": "guideline",
                "format": "md",
