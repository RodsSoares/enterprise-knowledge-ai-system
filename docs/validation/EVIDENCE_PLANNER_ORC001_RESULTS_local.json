              "status": "ready",
              "role": "section",
              "reading_text": "DATA SHARING POLICY\n\nDocument ID: DOC-005 | Version: 2.2 | Effective: 2026-01-01 | Status: ACTIVE | Domain: Information Security",
              "section_path": [
                "DATA SHARING POLICY"
              ],
              "metadata": {
