            {
              "unit_id": "DOC-025::unit-bbb3fa91a1e4f4958de0ca3277227f615cdf34fa8ecfa7efdd21fadfc7b51057",
              "document_id": "DOC-025",
              "status": "ready",
              "role": "section",
              "reading_text": "2. Procurement considerations\n\nProcurement should identify the provider, commercial model, expected users, intended business use, data categories, integration requirements, support model, portability, termination provisions, and material subcontractors.",
              "section_path": [
                "2. Procurement considerations"
              ],
              "metadata": {
